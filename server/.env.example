PORT=8787
DATABASE_URL=postgres://sync:sync@localhost:5432/sync_clipboard
JWT_SECRET=change-me-in-production
REFRESH_SECRET=change-me-too
UPLOAD_DIR=./uploads
MAX_FILE_BYTES=1073741824
CORS_ORIGIN=http://localhost:5173
WEB_DIST_DIR=../web/dist

# 飞牛单点登录（fn-sso）。不配置则登录页不显示 SSO 入口
# 回调地址自动取当前访问域名（外网域名:外网端口 或 内网IP:8787），无需配置前缀
SSO_ISSUER=http://a.gxc1994.top:28900
SSO_CLIENT_ID=你的_client_id
SSO_CLIENT_SECRET=你的_client_secret
SSO_NAME=飞牛账号
# 登录方式：默认只开放 SSO，邮箱密码登录/注册隐藏
# LOCAL_AUTH_ENABLED=true 时恢复邮箱密码登录（SSO 未配置时无论该值都会开放本地登录，防止锁死）
#LOCAL_AUTH_ENABLED=true
